}
@keyframes loading-out {
  0% {
    opacity: 1;
    height: 100vh;
  }
  99% {
    opacity: 0;
    height: 100vh;
  }
  100% {
    opacity: 0;
    height: 0;
  }
}
.body {
  position: relative;
}
.loading-overlay {
  content: '';
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  height: 100vh;
  background: #fff;
  z-index: 9999;
}
.loading-overlay::after {
  content: '';
  position: fixed;
  top: calc(50vh - 2.5rem);
  left: calc(50vw - 2.5rem);
  width: 5rem;
  height: 5rem;
  box-sizing: border-box;
  border: 6px solid transparent;
  border-color: #cc1626 transparent #cc1626 transparent;
  border-radius: 50%;
  animation: lds-dual-ring 1.2s linear infinite !important;
  opacity: 0.5;
}
body:not(.is-loaded) {
  overflow: hidden;
}
/* body:not(.is-loaded) * { transition: none !important; } */
body.is-loaded .loading-overlay {
  animation: loading-out 0.8s ease forwards !important;
}
body.is-loaded .loading-overlay::after {
  display: none;
}
.c-modal {
  position: fixed;
  bottom: 100vh;
  opacity: 0;
